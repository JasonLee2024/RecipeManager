{
  "ID": "8e3b1d09-6a0c-4b7d-92e0-1c5d7b9a3f4e",
  "Name": "东北老虎菜",
  "Category": "凉菜",
  "PrepTime": 20,
  "Ingredients": [
    {
      "Item": "旱黄瓜或黄瓜",
      "Amount": "1至2根"
    },
    {
      "Item": "青椒",
      "Amount": "1至2个（切丝）"
    },
    {
      "Item": "香菜",
      "Amount": "1小把（切段）"
    },
    {
      "Item": "大蒜",
      "Amount": "3瓣（切末）"
    },
    {
      "Item": "东北大酱或黄豆酱",
      "Amount": "1至1.5勺"
    },
    {
      "Item": "植物油",
      "Amount": "2勺（浇油）"
    }
  ],
  "Steps": [
    "黄瓜拍碎或切粗丝，与青椒丝、香菜段同放碗中；蒜末葱花置表面。",
    "植物油烧热浇在蒜葱上激香，稍凉后加大酱、生抽、香醋调匀，与黄瓜等拌匀尝味补盐。"
  ],
  "ServingNote": "东北家常凉菜，酱咸度差异大宜先少放；冷藏片刻更入味。",
