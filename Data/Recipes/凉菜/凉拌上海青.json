{
  "ID": "a96f59db-46b6-451c-99e7-dec5b1f62d6d",
  "Name": "凉拌上海青",
  "Category": "凉菜",
  "PrepTime": 20,
  "Ingredients": [
    {
      "Item": "上海青",
      "Amount": "400～500g"
    },
    {
      "Item": "大蒜",
      "Amount": "3～4瓣"
    },
    {
      "Item": "红椒",
      "Amount": "1～2个小米椒量（可选）"
    },
    {
      "Item": "生抽",
      "Amount": "1.5～2汤匙"
    },
    {
      "Item": "香醋",
      "Amount": "1～1.5汤匙"
    },
    {
      "Item": "香油",
      "Amount": "1茶匙"
    },
    {
      "Item": "白糖",
      "Amount": "1/3～1/2茶匙"
    },
    {
      "Item": "食盐",
      "Amount": "少许"
    }
  ],
  "Steps": [
    "水沸加少许盐与油，下上海青焯约30～40秒至七八成熟，捞出过凉水，轻轻挤干。",
    "碗中放蒜末、红椒圈、生抽、香醋、香油、糖、盐，搅匀尝味。",
    "与上海青拌匀装盘；可冷藏15分钟再食。"
  ],
