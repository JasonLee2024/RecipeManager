{
  "ID": "7769b1c0-4732-4833-830f-cc1a623cd5fd",
  "Name": "凉拌蒸茄子",
  "Category": "凉菜",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "大圆茄子",
      "Amount": "1个"
    },
    {
      "Item": "大蒜",
      "Amount": "适量（切末）"
    },
    {
      "Item": "生抽",
      "Amount": "适量"
    },
    {
      "Item": "香醋",
      "Amount": "适量"
    },
    {
      "Item": "白糖",
      "Amount": "少许"
    },
    {
      "Item": "香油",
      "Amount": "适量"
    },
    {
      "Item": "辣椒油",
      "Amount": "适量（可选）"
    },
    {
      "Item": "小葱或香菜",
      "Amount": "少许（可选）"
    },
    {
      "Item": "白醋",
      "Amount": "少许（可选，防氧化）"
    }
  ],
  "Steps": [
    "大圆茄子去皮，切粗条或厚片，避免过细以免蒸后易碎。",
    "水开后上锅蒸8至10分钟（按块大小调整），至筷子可轻松扎透；若怕氧化可尽快蒸或蒸前用极淡白醋水略浸。",
    "倒出多余汤汁，用筷子拨散晾凉，可略挤去水分。",
    "加蒜末、生抽、香醋、少许糖、香油、可选辣椒油，撒葱花或香菜，拌匀即可。"
  ],
