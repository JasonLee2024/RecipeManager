{
  "ID": "9f4c2e1a-7b0d-4c8e-a3f1-2d6e8c0b4a5f",
  "Name": "拍黄瓜",
  "Category": "凉菜",
  "PrepTime": 15,
  "Ingredients": [
    {
      "Item": "旱黄瓜或小黄瓜",
      "Amount": "2根（约400-500克）"
    },
    {
      "Item": "大蒜",
      "Amount": "3至4瓣（切末）"
    },
    {
      "Item": "生抽",
      "Amount": "1.5至2勺"
    },
    {
      "Item": "香醋",
      "Amount": "1至1.5勺"
    },
    {
      "Item": "香油",
      "Amount": "半勺"
    },
    {
      "Item": "白糖",
      "Amount": "半茶匙至1茶匙"
    },
    {
      "Item": "盐",
      "Amount": "少许"
    }
  ],
  "Steps": [
    "黄瓜洗净用刀背拍裂成块，蒜末与生抽、香醋、香油、糖、盐调成料汁。",
    "料汁与黄瓜块拌匀，可选花椒油或干辣椒；冷藏15至30分钟再食更入味。"
  ],
  "ServingNote": "宜配粥、面食或作下酒小菜；喜辣可改辣椒油。",
