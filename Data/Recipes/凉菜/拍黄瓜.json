{
  "ID": "9f4c2e1a-7b0d-4c8e-a3f1-2d6e8c0b4a5f",
  "Name": "拍黄瓜",
  "Category": "凉菜",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "旱黄瓜或嫩黄瓜",
      "Amount": "2至3根"
    },
    {
      "Item": "盐（杀水用）",
      "Amount": "半小勺"
    },
    {
      "Item": "大蒜",
      "Amount": "4至5瓣（切末或蒜泥）"
    },
    {
      "Item": "生抽",
      "Amount": "2勺"
    },
    {
      "Item": "香醋",
      "Amount": "2勺"
    },
    {
      "Item": "白糖",
      "Amount": "1小勺"
    },
    {
      "Item": "辣椒油或油泼辣子",
      "Amount": "1至2勺（可选）"
    },
    {
      "Item": "香油",
      "Amount": "1勺"
    },
    {
      "Item": "盐",
      "Amount": "少许（补味）"
    },
    {
      "Item": "花椒油",
      "Amount": "半勺（可选）"
    },
    {
      "Item": "植物油",
      "Amount": "1小勺（爆香浇油用，可选）"
    },
    {
      "Item": "香菜或小葱",
      "Amount": "少许（可选）"
    }
  ],
  "Steps": [
    "黄瓜拍裂后切3至4厘米段，加盐抓匀腌10分钟，倒掉渗出水。",
    "蒜末与生抽、香醋、糖、辣椒油、香油、盐、花椒油调成料汁；倒入黄瓜，撒香菜或葱，拌匀；可选热油淋蒜与辣椒面激香。",
    "静置约5分钟再食；不宜久放超过约20分钟以免变软。"
  ],
  "ServingNote": "酸辣爽脆、蒜香浓郁；配粥、面食或下酒；不吃辣可省略辣椒油。",
