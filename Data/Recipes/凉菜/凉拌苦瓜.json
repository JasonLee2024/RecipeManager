  "Name": "凉拌苦瓜",
  "Category": "凉菜",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "苦瓜",
      "Amount": "1根"
    },
    {
      "Item": "大蒜",
      "Amount": "2至3瓣"
    },
    {
      "Item": "熟白芝麻",
      "Amount": "少许"
    },
    {
      "Item": "生抽",
      "Amount": "2勺"
    },
    {
      "Item": "香醋",
      "Amount": "1勺"
    },
    {
      "Item": "白糖",
      "Amount": "1勺"
    },
    {
      "Item": "香油",
      "Amount": "半勺"
    },
    {
      "Item": "盐",
      "Amount": "少许"
    },
    {
      "Item": "辣椒油",
      "Amount": "少许（可选）"
    }
  ],
  "Steps": [
    "苦瓜剖开刮净白瓤，切薄片；沸水焯烫约40秒，立刻捞入冰水浸泡5分钟，捞出沥干。",
    "蒜末与生抽、香醋、白糖、香油、盐调成料汁，尝味后微调。",
    "料汁浇在苦瓜上，撒白芝麻与可选辣椒油，拌匀即可；可冷藏10分钟再食。"
  ],
