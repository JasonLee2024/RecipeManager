{
  "ID": "126de682-6f0d-4f76-a8f3-159f9c7bc81f",
  "Name": "葛根粉条鲮鱼猪骨汤",
  "Category": "汤羹",
  "PrepTime": 130,
  "Ingredients": [
    {
      "Item": "猪肉",
      "Amount": "猪筒骨或扇骨400～500g，焯水洗净"
    },
    {
      "Item": "鲮鱼",
      "Amount": "鲜鱼1条或鱼干适量"
    },
    {
      "Item": "葛根粉条",
      "Amount": "干约50～80g，泡软"
    },
    {
      "Item": "生姜",
      "Amount": "1大块拍松"
    },
    {
      "Item": "蜜枣",
      "Amount": "1～2颗（可选）"
    },
    {
      "Item": "陈皮",
      "Amount": "1小片（可选）"
    },
    {
      "Item": "食盐",
      "Amount": "起锅前适量"
    },
    {
      "Item": "清水",
      "Amount": "约1.5～2L"
    }
  ],
  "Steps": [
    "猪骨焯水洗净；鲜鲮鱼可煎至两面微黄（可选）。",
    "汤煲加足水、猪骨、姜及可选蜜枣、陈皮，大火烧开转小火煲1～1.5小时。",
    "下鲮鱼续煲20～30分钟；下泡软葛根粉条煮8～12分钟至入味，加盐调味。"
  ],
