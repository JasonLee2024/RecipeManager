{
  "ID": "a5f74314-43f5-4a6e-9159-04d7d1a3b9d2",
  "Name": "瓠瓜三鲜汤",
  "Category": "汤羹",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "瓠瓜",
      "Amount": "约400克（去皮切片）"
    },
    {
      "Item": "虾皮",
      "Amount": "1小把（可选）"
    },
    {
      "Item": "香菇",
      "Amount": "2-3朵（干泡发或鲜）"
    },
    {
      "Item": "金针菇",
      "Amount": "1把"
    },
    {
      "Item": "葱姜",
      "Amount": "少许"
    },
    {
      "Item": "盐、白胡椒粉、香油",
      "Amount": "适量"
    },
    {
      "Item": "清水或高汤",
      "Amount": "800-1000毫升"
    }
  ],
  "Steps": [
    "香菇处理好；金针菇去根洗净；瓠瓜去皮切片，偏老则去籽瓤。",
    "少许油炒香葱姜，加入虾皮与香菇炒出香味。",
    "加入瓠瓜翻炒1分钟，倒入开水或高汤煮5分钟。",
    "加入金针菇再煮2-3分钟至熟。",
    "加盐与白胡椒调味，关火后淋少许香油。"
  ],
  "ServingNote": "以虾皮/菌菇做“轻提鲜”，不宜久煮，保持瓠瓜清甜。",
  "Tags": [
    "家常菜",
    "浙菜",
