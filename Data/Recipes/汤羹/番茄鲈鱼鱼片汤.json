{
  "ID": "88b7d528-6e43-4e66-82be-c6f8cf59b479",
  "Name": "番茄鲈鱼鱼片汤",
  "Category": "汤羹",
  "PrepTime": 35,
  "Ingredients": [
    {
      "Item": "鲈鱼",
      "Amount": "1条取两侧净肉切薄片"
    },
    {
      "Item": "番茄",
      "Amount": "2～3个中等切块"
    },
    {
      "Item": "鸡蛋",
      "Amount": "蛋清1个份上浆"
    },
    {
      "Item": "淀粉",
      "Amount": "1～2茶匙"
    },
    {
      "Item": "食盐",
      "Amount": "适量"
    },
    {
      "Item": "白糖",
      "Amount": "适量"
    },
    {
      "Item": "生姜",
      "Amount": "少许切丝或末"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    },
    {
      "Item": "清水",
      "Amount": "约600～800ml或高汤"
    },
    {
      "Item": "香醋",
      "Amount": "少许起锅前提香（可选）"
    },
    {
      "Item": "大葱",
      "Amount": "葱花少许"
    }
  ],
  "Steps": [
    "鱼片用盐抓黏，加蛋清与淀粉上浆，静置10分钟；番茄备用。",
    "热锅少油炒香姜丝，下番茄中火炒出汁，加糖盐调味，加水或高汤煮开。",
    "转小火保持微沸，鱼片分散下入，先勿搅动；变白定型后轻推散，烫煮约1分钟。",
    "可选淋少许醋，撒葱花出锅。"
  ],
  "ServingNote": "鱼片定型后再推防碎；上浆前吸干鱼肉。番茄酸度不足可按喜好加少许番茄酱。",
