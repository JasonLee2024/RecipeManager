{
  "ID": "705d6375-1d5e-4b88-910a-4cb5d4e822b4",
  "Name": "鲈鱼豆腐汤",
  "Category": "汤羹",
  "PrepTime": 35,
  "Ingredients": [
    {
      "Item": "鲈鱼",
      "Amount": "1条或切段，处理干净"
    },
    {
      "Item": "豆腐",
      "Amount": "300～400g切块"
    },
    {
      "Item": "生姜",
      "Amount": "数片"
    },
    {
      "Item": "大葱",
      "Amount": "少许切段与葱花"
    },
    {
      "Item": "料酒",
      "Amount": "1汤匙（可选）"
    },
    {
      "Item": "食盐",
      "Amount": "适量"
    },
    {
      "Item": "胡椒粉",
      "Amount": "白胡椒粉适量"
    },
    {
      "Item": "植物油",
      "Amount": "煎鱼用量"
    },
    {
      "Item": "开水",
      "Amount": "约800～1200ml滚烫"
    }
  ],
  "Steps": [
    "鱼身擦干，热锅油煎至两面金黄；下姜片、葱段煸香，烹料酒（可选）。",
    "冲入滚烫开水，大火煮约5分钟至汤色转白。",
    "下豆腐块，中火续煮5～8分钟。",
    "加盐、白胡椒粉调味，撒葱花出锅。"
  ],
  "ServingNote": "乳白汤关键：煎香后冲开水并大火滚煮；煎前吸干水分。海鲈鱼控盐。",
