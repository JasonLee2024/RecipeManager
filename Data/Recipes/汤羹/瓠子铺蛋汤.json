{
  "ID": "8c0e7f6e-6c4a-4c02-9d0a-9b0a7e6ffb87",
  "Name": "瓠子铺蛋汤",
  "Category": "汤羹",
  "PrepTime": 15,
  "Ingredients": [
    {
      "Item": "瓠瓜",
      "Amount": "约300-400克（去皮切片）"
    },
    {
      "Item": "鸡蛋",
      "Amount": "1-2个"
    },
    {
      "Item": "葱花",
      "Amount": "适量"
    },
    {
      "Item": "盐",
      "Amount": "适量"
    },
    {
      "Item": "白胡椒粉、香油",
      "Amount": "少许（可选）"
    },
    {
      "Item": "清水或高汤",
      "Amount": "600-800毫升"
    }
  ],
  "Steps": [
    "瓠瓜去皮切片，偏老则去籽瓤。",
    "少许油炝葱花，下瓠瓜翻炒至略变软。",
    "加水或高汤煮开，煮2-3分钟。",
    "小火沿锅边均匀淋入蛋液，静置片刻待蛋花成形后轻推散开。",
    "加盐与白胡椒调味，关火后滴少许香油即可。"
  ],
  "ServingNote": "关键在“铺蛋”：蛋液下锅后先别急搅，等其凝结成大块蛋花口感更好。",
