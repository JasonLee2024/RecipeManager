{
  "ID": "8c0e7f6e-6c4a-4c02-9d0a-9b0a7e6ffb87",
  "Name": "瓠子铺蛋汤",
  "Category": "汤羹",
  "PrepTime": 15,
  "Ingredients": [
    {
      "Item": "瓠瓜",
      "Amount": "约300-400克（去皮切片）"
    },
    {
      "Item": "鸡蛋",
      "Amount": "1-2个"
    },
    {
      "Item": "葱花",
      "Amount": "适量"
    },
    {
      "Item": "盐",
      "Amount": "适量"
    },
    {
      "Item": "白胡椒粉、香油",
      "Amount": "少许（可选）"
    },
    {
      "Item": "玉米淀粉",
      "Amount": "极少量（可选）"
    },
    {
      "Item": "清水或高汤",
      "Amount": "600-800毫升"
    }
  ],
  "Steps": [
    "瓠瓜去皮切片，偏老则去籽瓤。",
    "少许油炝葱花，下瓠瓜中火翻炒约1-2分钟至略软，勿久炒以免煮汤发浑、瓜肉易散。",
    "加水或高汤煮开，煮2-3分钟。",
    "（可选）极少量玉米淀粉冷水调匀，小火淋入搅匀至微稠；追求清爽可不勾芡。",
    "小火沿锅边均匀淋入蛋液，静置片刻待蛋花成形后轻推散开。",
    "加盐与白胡椒调味，关火后滴少许香油即可。"
  ],
  "ServingNote": "关键在“铺蛋”：蛋液下锅后先别急搅，等其凝结成大块蛋花口感更好。煸炒瓠瓜不宜过久；铺蛋用小火、静置后再轻推，汤色更清爽。默认不勾芡更清爽；略稠口感可选极薄芡，铺蛋前勾入。",
