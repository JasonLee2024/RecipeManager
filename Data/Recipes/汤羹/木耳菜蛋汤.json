{
  "ID": "8d5b09f2-c4a3-5e72-0b14-3a9f7e2d5c11",
  "Name": "木耳菜蛋汤",
  "Category": "汤羹",
  "PrepTime": 15,
  "Ingredients": [
    {
      "Item": "木耳菜",
      "Amount": "约200g"
    },
    {
      "Item": "鸡蛋",
      "Amount": "2个"
    },
    {
      "Item": "干木耳",
      "Amount": "少许（泡发撕小朵）"
    },
    {
      "Item": "姜丝",
      "Amount": "少许"
    },
    {
      "Item": "清水或高汤",
      "Amount": "适量"
    },
    {
      "Item": "食盐",
      "Amount": "少许"
    },
    {
      "Item": "香油",
      "Amount": "几滴"
    }
  ],
  "Steps": [
    "鸡蛋打散；干木耳泡发撕小朵；木耳菜洗净去老根。",
    "水沸下姜丝与木耳煮2～3分钟。",
    "转中小火淋入蛋液成蛋花，立即下木耳菜。",
    "煮至木耳菜变色变软，加盐与香油出锅；木耳菜入锅后不超过约1分钟。"
  ],
  "Tags": [
