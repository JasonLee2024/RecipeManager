{
  "ID": "af2b7f36-15a5-48c0-b292-ba8b41547a6c",
  "Name": "清炖排骨",
  "Category": "汤羹",
  "PrepTime": 110,
  "Ingredients": [
    {
      "Item": "猪小排或猪肋排",
      "Amount": "500-800克"
    },
    {
      "Item": "姜",
      "Amount": "4-6片"
    },
    {
      "Item": "葱",
      "Amount": "2段"
    },
    {
      "Item": "料酒",
      "Amount": "1勺"
    },
    {
      "Item": "盐",
      "Amount": "适量"
    },
    {
      "Item": "白胡椒粉",
      "Amount": "少许"
    },
    {
      "Item": "玉米",
      "Amount": "1根（可选）"
    },
    {
      "Item": "胡萝卜",
      "Amount": "1根（可选）"
    },
    {
      "Item": "白萝卜",
      "Amount": "半根（可选）"
    }
  ],
  "Steps": [
    "排骨切段后冷水浸泡约1小时（可选），冷水下锅加姜片、葱段、料酒焯水，撇净浮沫后煮3-5分钟捞出。",
    "焯好的排骨用温水冲净，放入炖锅并一次性加入足量开水，先大火煮沸后转小火慢炖60分钟。",
    "加入玉米、胡萝卜、白萝卜等配菜继续炖20-30分钟，关火前10-15分钟加盐，出锅前加少许白胡椒粉。"
  ],
  "ServingNote": "汤色清亮、味道温润，适合搭配米饭或面食；也可取汤煮面做一锅两吃。",
