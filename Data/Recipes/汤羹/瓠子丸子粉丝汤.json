{
  "ID": "ce3dcd1e-0d02-4d33-9d43-5a83d15f21c6",
  "Name": "瓠子丸子粉丝汤",
  "Category": "汤羹",
  "PrepTime": 35,
  "Ingredients": [
    {
      "Item": "瓠瓜",
      "Amount": "约400-500克（去皮切片）"
    },
    {
      "Item": "猪肉馅",
      "Amount": "200-300克"
    },
    {
      "Item": "粉丝",
      "Amount": "1把（泡软）"
    },
    {
      "Item": "葱花、姜片",
      "Amount": "适量"
    },
    {
      "Item": "盐、白胡椒粉",
      "Amount": "适量"
    },
    {
      "Item": "淀粉",
      "Amount": "1小勺（用于肉馅）"
    },
    {
      "Item": "清水或高汤",
      "Amount": "1-1.2升"
    }
  ],
  "Steps": [
    "粉丝温水泡软备用；瓠瓜去皮切片，偏老则去籽瓤。",
    "肉馅加盐、白胡椒、淀粉和少量葱姜水搅打至黏稠。",
    "少许油爆香葱姜，下瓠瓜翻炒后加开水/高汤煮开。",
    "转小火挤丸子下锅，微沸5-8分钟至丸子熟透浮起。",
    "加入粉丝煮1-2分钟，加盐调味即可。"
  ],
  "ServingNote": "粉丝后下更耐煮；丸子不宜太大，易熟且更嫩。",
  "Tags": [
    "家常菜",
    "浙菜",
