{
  "ID": "0adfb2dc-3300-4dbd-9094-cc8a4d5ceb37",
  "Name": "豆角香肠炖葛根粉条",
  "Category": "炒菜",
  "PrepTime": 70,
  "Ingredients": [
    {
      "Item": "葛根粉条",
      "Amount": "干约80～100g"
    },
    {
      "Item": "干豆角",
      "Amount": "50～80g泡软（或鲜豆角200g）"
    },
    {
      "Item": "香肠",
      "Amount": "1～2根切片"
    },
    {
      "Item": "猪肉",
      "Amount": "五花肉片80g（可选）"
    },
    {
      "Item": "大蒜",
      "Amount": "3瓣"
    },
    {
      "Item": "八角",
      "Amount": "1颗（可选）"
    },
    {
      "Item": "生抽",
      "Amount": "2汤匙"
    },
    {
      "Item": "老抽",
      "Amount": "1/2茶匙"
    },
    {
      "Item": "白糖",
      "Amount": "适量"
    },
    {
      "Item": "食盐",
      "Amount": "适量"
    },
    {
      "Item": "清水",
      "Amount": "约500～700ml"
    },
    {
      "Item": "植物油",
      "Amount": "少许"
    }
  ],
  "Steps": [
    "葛根粉条泡软；干豆角泡软切段（鲜豆角则切段备用）。",
    "少油煸香蒜片与可选八角，下五花肉与香肠炒出油香，下豆角加生抽、老抽、糖与清水烧开。",
    "中小火炖15～20分钟至豆角软烂，下粉条浸没汤汁再炖8～10分钟收汁，补盐出锅。"
  ],
