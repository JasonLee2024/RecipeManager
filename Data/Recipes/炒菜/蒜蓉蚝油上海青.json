{
  "ID": "d8d189ac-51d1-4f2c-bc29-66c3e28b8912",
  "Name": "蒜蓉蚝油上海青",
  "Category": "炒菜",
  "PrepTime": 20,
  "Ingredients": [
    { "Item": "上海青", "Amount": "400～500g" },
    { "Item": "大蒜", "Amount": "1整头或更多" },
    { "Item": "蚝油", "Amount": "1.5～2汤匙" },
    { "Item": "食盐", "Amount": "少许" },
    { "Item": "植物油", "Amount": "适量" },
    { "Item": "清水", "Amount": "2～3汤匙或水淀粉少许" }
  ],
  "Steps": [
    "水烧开，加几滴油和少许盐，下上海青焯1～2分钟至断生，捞出沥干装盘。",
    "锅中留底油，小火下蒜蓉煸香，加蚝油与少量清水或水淀粉煮至略稠。",
    "将蒜蓉蚝油汁均匀浇在摆好的上海青上即可。"
  ],
