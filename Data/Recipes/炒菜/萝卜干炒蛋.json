{
  "ID": "84df7d62-a93f-4ec6-87b8-a3e09f5773be",
  "Name": "萝卜干炒蛋",
  "Category": "炒菜",
  "PrepTime": 20,
  "Ingredients": [
    {
      "Item": "萧山萝卜干",
      "Amount": "适量"
    },
    {
      "Item": "鸡蛋",
      "Amount": "2-3个"
    },
    {
      "Item": "葱花、食用油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "萝卜干浸泡冲洗后切碎，鸡蛋打散成蛋液。",
    "锅中下油，小火先煸炒萝卜干碎，让油分充分浸润。",
    "将萝卜干拨到锅边，倒入蛋液，待蛋液半凝固时与萝卜干翻炒均匀。",
    "撒上葱花，快速翻炒几下即可出锅。"
  ],
  "ServingNote": "本菜咸味主要来自萝卜干，通常不需要另加盐。",
