{
  "ID": "5eb4e0bd-2808-4ea5-9d13-11ccf8f7dc2f",
  "Name": "豆瓣鲤鱼",
  "Category": "炒菜",
  "PrepTime": 50,
  "Ingredients": [
    {
      "Item": "鲤鱼",
      "Amount": "1条（约700-900克）"
    },
    {
      "Item": "郫县豆瓣酱",
      "Amount": "1-2大勺（剁细）"
    },
    {
      "Item": "姜末、蒜末、葱花",
      "Amount": "适量"
    },
    {
      "Item": "料酒、酱油",
      "Amount": "适量"
    },
    {
      "Item": "白糖",
      "Amount": "较平时略多"
    },
    {
      "Item": "米醋",
      "Amount": "分两次加入"
    },
    {
      "Item": "水淀粉",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "鲤鱼处理后擦干并改刀，入锅煎至两面金黄后盛出。",
    "锅中留底油，低油温慢煸剁细豆瓣酱至红油透亮，加入姜末蒜末炒香并烹入料酒。",
    "加足量水后放酱油、白糖和大部分米醋调味，煮开后下鱼中小火烧至入味。",
    "烧制期间多次浇淋鱼身帮助均匀着味，成熟后先将鱼盛盘。",
    "锅中汤汁勾薄芡，下葱花并补少许生醋提香，淋在鱼身即可。"
  ],
  "ServingNote": "先煎后烧可保持鱼身完整；鲤鱼体型较大，烧制时间通常比鲫鱼略长。",
