  "ID": "a81257f4-9e13-459f-812d-214014bd6994",
  "Name": "五花肉焖葛根粉条",
  "Category": "炒菜",
  "PrepTime": 75,
  "Ingredients": [
    {
      "Item": "葛根粉条",
      "Amount": "干约80～100g"
    },
    {
      "Item": "猪肉",
      "Amount": "五花肉250～300g"
    },
    {
      "Item": "生姜",
      "Amount": "数片"
    },
    {
      "Item": "大蒜",
      "Amount": "3瓣"
    },
    {
      "Item": "葱",
      "Amount": "1段"
    },
    {
      "Item": "生抽",
      "Amount": "2汤匙"
    },
    {
      "Item": "老抽",
      "Amount": "1茶匙"
    },
    {
      "Item": "料酒",
      "Amount": "1汤匙"
    },
    {
      "Item": "白糖",
      "Amount": "1茶匙"
    },
    {
      "Item": "食盐",
      "Amount": "少许"
    },
    {
      "Item": "清水",
      "Amount": "适量"
    },
    {
      "Item": "植物油",
      "Amount": "少量"
    }
  ],
  "Steps": [
    "粉条泡软；五花肉可焯水去沫（可选）。",
    "少量底油下五花肉中小火煸出油至微焦黄，下姜葱蒜炒香，淋料酒。",
    "加生抽、老抽、糖与清水没过肉块，大火烧开转小火焖25～35分钟至肉软。",
    "下粉条浸没汤汁，盖盖再焖10～15分钟收汁翻匀，补盐出锅。"
  ],
