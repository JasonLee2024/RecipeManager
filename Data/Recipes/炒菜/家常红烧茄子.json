  "ID": "91c397e2-d4f6-4403-a892-f192072a9092",
  "Name": "家常红烧茄子",
  "Category": "炒菜",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "圆茄或长茄",
      "Amount": "约500g"
    },
    {
      "Item": "大蒜",
      "Amount": "3至4瓣"
    },
    {
      "Item": "生姜",
      "Amount": "1小块"
    },
    {
      "Item": "小葱",
      "Amount": "1至2根"
    },
    {
      "Item": "干辣椒",
      "Amount": "2至3个（可选）"
    },
    {
      "Item": "生抽",
      "Amount": "2勺"
    },
    {
      "Item": "老抽",
      "Amount": "1勺"
    },
    {
      "Item": "蚝油",
      "Amount": "1勺"
    },
    {
      "Item": "白糖",
      "Amount": "1小勺"
    },
    {
      "Item": "淀粉",
      "Amount": "1勺"
    },
    {
      "Item": "清水",
      "Amount": "约半碗"
    },
    {
      "Item": "盐",
      "Amount": "约1小勺（腌茄用）"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "茄子切滚刀块，加盐腌10分钟后挤干水分，避免过度吸油。",
    "生抽、老抽、蚝油、白糖、淀粉与清水调成碗汁备用。",
    "热锅倒油，下茄子中小火煸至表面微黄、整体变软。",
    "将茄子拨到一边，用余油爆香蒜末、姜末、葱花和可选干辣椒。",
    "倒入碗汁大火翻匀，收至汤汁浓稠裹住茄块后出锅。"
  ],
