{
  "ID": "2c4a168b-f1fa-4a56-9376-c3e54e008ca4",
  "Name": "上海青炒油豆腐",
  "Category": "炒菜",
  "PrepTime": 20,
  "Ingredients": [
    { "Item": "上海青", "Amount": "350～450g" },
    { "Item": "油豆腐", "Amount": "150～200g，对半切开" },
    { "Item": "大蒜", "Amount": "2～3瓣" },
    { "Item": "生抽", "Amount": "约1汤匙" },
    { "Item": "蚝油", "Amount": "约1汤匙" },
    { "Item": "白糖", "Amount": "少许" },
    { "Item": "食盐", "Amount": "适量" },
    { "Item": "植物油", "Amount": "适量" },
    { "Item": "清水", "Amount": "2～3汤匙" }
  ],
  "Steps": [
    "热锅倒植物油，爆香蒜片或蒜末。",
    "先下菜梗与对半切开的油豆腐，中火翻炒，加少量清水，盖盖焖约1分钟让油豆腐回软吸味。",
    "下菜叶，转大火，加生抽、蚝油、白糖翻匀，按口味补盐，收汁出锅。"
  ],
