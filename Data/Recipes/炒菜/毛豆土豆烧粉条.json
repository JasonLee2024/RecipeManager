{
  "ID": "c4e8f1a2-6b3d-4c91-9f0e-2d7a8b1c3e55",
  "Name": "毛豆土豆烧粉条",
  "Category": "炒菜",
  "PrepTime": 45,
  "Ingredients": [
    {
      "Item": "土豆",
      "Amount": "适量，去皮切约1.5cm小丁"
    },
    {
      "Item": "手剥毛豆",
      "Amount": "适量"
    },
    {
      "Item": "葛根粉条",
      "Amount": "干品适量，温水泡软沥干"
    },
    {
      "Item": "清水或高汤",
      "Amount": "没过食材"
    },
    {
      "Item": "生抽",
      "Amount": "适量"
    },
    {
      "Item": "老抽",
      "Amount": "适量（上色）"
    },
    {
      "Item": "蚝油",
      "Amount": "适量"
    },
    {
      "Item": "食盐",
      "Amount": "适量"
    },
    {
      "Item": "白糖",
      "Amount": "少许"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    },
    {
      "Item": "五花肉",
      "Amount": "几片（可选）"
    },
    {
      "Item": "干辣椒、八角",
      "Amount": "少许（可选）"
    }
  ],
  "Steps": [
    "葛根粉条温水泡至无硬芯，沥干，必要时剪短；土豆切丁。",
    "热油下土豆丁煎至表面微焦，下毛豆翻炒；可选下五花肉煸出油，或加干辣椒、八角煸香。",
    "加清水或高汤没过食材，下粉条，以生抽、老抽、蚝油、盐、糖调味。",
    "中火煮5～8分钟至土豆软烂、粉条透明、汤汁浓稠即可。"
  ],
