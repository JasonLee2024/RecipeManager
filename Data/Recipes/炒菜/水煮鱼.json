{
  "ID": "4ee2f5cd-f62f-4cf3-81cb-75db9bc57748",
  "Name": "水煮鱼",
  "Category": "炒菜",
  "PrepTime": 40,
  "Ingredients": [
    {
      "Item": "草鱼或黑鱼鱼片",
      "Amount": "400克"
    },
    {
      "Item": "豆芽或生菜",
      "Amount": "适量"
    },
    {
      "Item": "郫县豆瓣酱",
      "Amount": "2大勺（剁细）"
    },
    {
      "Item": "姜末、蒜末",
      "Amount": "适量"
    },
    {
      "Item": "刀口辣椒、花椒",
      "Amount": "大量（封油用）"
    },
    {
      "Item": "料酒、酱油、白糖、白胡椒粉",
      "Amount": "适量"
    },
    {
      "Item": "菜籽油",
      "Amount": "适量（底油+响油）"
    }
  ],
  "Steps": [
    "鱼片加少许盐、料酒和淀粉抓匀腌制10分钟；垫菜焯熟后铺入碗中。",
    "鱼片在微开水中滑煮至八九成熟，捞出铺在垫菜上。",
    "锅中低油温慢煸剁细豆瓣酱至红油亮丽，加入姜末蒜末炒香，再加高汤或清水。",
    "用料酒、少许酱油、白糖和白胡椒粉调味，小火熬煮数分钟后浇入碗中。",
    "碗中央撒蒜末、刀口辣椒和花椒，另起锅将菜籽油烧至七八成热后浇淋爆香。"
  ],
  "ServingNote": "关键在于底油低温煸红和最后高温响油两段用油；鱼片不宜久煮，以免口感变老。",
