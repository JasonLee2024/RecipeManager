{
  "ID": "df65328c-766f-4796-86e4-c26863efbabb",
  "Name": "豆豉腊肉炒蒜苗",
  "Category": "炒菜",
  "PrepTime": 20,
  "Ingredients": [
    {
      "Item": "腊肉或腊肠",
      "Amount": "200至250g"
    },
    {
      "Item": "蒜苗",
      "Amount": "250g"
    },
    {
      "Item": "豆豉",
      "Amount": "1大勺"
    },
    {
      "Item": "大蒜",
      "Amount": "2瓣"
    },
    {
      "Item": "生姜",
      "Amount": "1小块"
    },
    {
      "Item": "生抽",
      "Amount": "少许（按需）"
    },
    {
      "Item": "白糖",
      "Amount": "少许"
    }
  ],
  "Steps": [
    "腊肉切薄片，蒜苗分开蒜白与蒜绿切段，豆豉冲洗后沥干备用。",
    "锅中少油或不放油，小火煸炒腊肉至出油、边缘微卷。",
    "利用锅中油脂炒香蒜末、姜末与豆豉，炒至香气明显。",
    "先下蒜白大火快炒约20秒，再下蒜绿继续快炒至断生。",
    "按咸度补少量生抽和白糖提鲜，翻匀出锅。"
  ],
