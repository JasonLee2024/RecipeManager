{
  "ID": "eb273613-75d5-440f-8264-20782cdbd88c",
  "Name": "苦瓜酿肉",
  "Category": "炒菜",
  "PrepTime": 40,
  "Ingredients": [
    {
      "Item": "苦瓜",
      "Amount": "1根"
    },
    {
      "Item": "猪肉末",
      "Amount": "150g"
    },
    {
      "Item": "干香菇",
      "Amount": "2至3朵"
    },
    {
      "Item": "姜",
      "Amount": "1小块"
    },
    {
      "Item": "小葱",
      "Amount": "2根"
    },
    {
      "Item": "枸杞",
      "Amount": "少许（可选）"
    },
    {
      "Item": "生抽",
      "Amount": "适量"
    },
    {
      "Item": "蚝油",
      "Amount": "适量"
    },
    {
      "Item": "白胡椒粉",
      "Amount": "适量"
    },
    {
      "Item": "白糖",
      "Amount": "少许"
    },
    {
      "Item": "淀粉",
      "Amount": "适量"
    },
    {
      "Item": "水淀粉",
      "Amount": "少许"
    }
  ],
  "Steps": [
    "苦瓜切成2至3厘米厚的圈，挖净内瓤与白膜；香菇泡发切丁。",
    "肉末加葱姜末、生抽、蚝油、白胡椒粉、糖、淀粉搅打上劲，拌入香菇丁。",
    "肉馅填入苦瓜圈压实抹平，码盘，可点缀枸杞；水开后中火蒸8至10分钟至熟透。",
    "按需留用蒸汁，入锅加生抽与清水烧开，勾薄芡淋在酿苦瓜上。"
  ],
