{
  "ID": "9e186c25-703b-49aa-bac1-a9a0dcc3ff68",
  "Name": "砂锅焗鲈鱼",
  "Category": "炒菜",
  "PrepTime": 45,
  "Ingredients": [
    {
      "Item": "鲈鱼",
      "Amount": "1条切块或大片，约450～650g"
    },
    {
      "Item": "食盐",
      "Amount": "少许腌鱼"
    },
    {
      "Item": "蚝油",
      "Amount": "1汤匙"
    },
    {
      "Item": "生抽",
      "Amount": "1汤匙"
    },
    {
      "Item": "海鲜酱",
      "Amount": "1～2茶匙（或黄豆酱）"
    },
    {
      "Item": "生粉",
      "Amount": "1～2茶匙"
    },
    {
      "Item": "生姜",
      "Amount": "数片或小块"
    },
    {
      "Item": "大蒜",
      "Amount": "1～2头蒜瓣"
    },
    {
      "Item": "洋葱",
      "Amount": "半个至1个切块"
    },
    {
      "Item": "米酒",
      "Amount": "约2～3汤匙沿锅盖淋入"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    },
    {
      "Item": "大葱",
      "Amount": "葱花少许"
    }
  ],
  "Steps": [
    "鱼块用盐、蚝油、生抽、海鲜酱、生粉与姜片抓匀，腌20分钟。",
    "砂锅中火烧热倒油，爆香蒜瓣、姜块与洋葱。",
    "铺入鱼块与腌汁，加盖，沿锅盖淋米酒，中火焗8～10分钟至熟透。",
    "开盖撒葱花，趁热上桌。"
  ],
  "ServingNote": "砂锅忌裂纹与猛火糊底；鱼块下锅前轻吸表面防溅油。酱料已咸时慎补盐；海鲈鱼减蚝油或生抽。",
