{
  "ID": "f1a9eb74-2bf2-4c8d-9ec6-2d733f52243e",
  "Name": "麻婆豆腐",
  "Category": "炒菜",
  "PrepTime": 30,
  "Ingredients": [
    {
      "Item": "北豆腐或卤水豆腐",
      "Amount": "1块（约400克）"
    },
    {
      "Item": "牛肉末",
      "Amount": "150克"
    },
    {
      "Item": "郫县豆瓣酱",
      "Amount": "1-1.5大勺（剁细）"
    },
    {
      "Item": "豆豉",
      "Amount": "少许"
    },
    {
      "Item": "蒜末、姜末",
      "Amount": "适量"
    },
    {
      "Item": "细辣椒面",
      "Amount": "少许"
    },
    {
      "Item": "青蒜苗段",
      "Amount": "适量"
    },
    {
      "Item": "料酒、酱油、白糖",
      "Amount": "各少许"
    },
    {
      "Item": "水淀粉",
      "Amount": "适量（分2-3次使用）"
    },
    {
      "Item": "花椒面",
      "Amount": "出锅现撒"
    }
  ],
  "Steps": [
    "豆腐切块后放入加盐热水浸泡3-5分钟或轻焯，捞出备用。",
    "牛肉末小火煸炒至酥香后盛出；锅中留油，低油温下入剁细豆瓣酱慢煸至红油透亮。",
    "加入蒜末、少量豆豉和细辣椒面炒香，烹入料酒，加入高汤或清水煮开。",
    "下豆腐，加少许酱油与白糖，中小火烧几分钟让豆腐充分吸味。",
    "分2-3次淋入水淀粉勾芡，回入牛肉末和青蒜苗段，装盘后现撒花椒面。"
  ],
  "ServingNote": "豆瓣酱和豆豉咸度较高，建议先尝味后再补盐；花椒面建议上桌前现撒以保留麻香。",
