{
  "ID": "b09f7b9e-2f4c-4f9a-ae3a-0b0c2a6b7d3f",
  "Name": "五花肉炒瓠瓜",
  "Category": "炒菜",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "瓠瓜",
      "Amount": "约400克（去皮切片/条）"
    },
    {
      "Item": "五花肉",
      "Amount": "150-200克（切薄片）"
    },
    {
      "Item": "姜蒜",
      "Amount": "少许"
    },
    {
      "Item": "小米辣",
      "Amount": "少许（可选）"
    },
    {
      "Item": "盐",
      "Amount": "适量"
    },
    {
      "Item": "生抽",
      "Amount": "1勺（可选）"
    },
    {
      "Item": "孜然粉",
      "Amount": "少许（可选）"
    }
  ],
  "Steps": [
    "瓠瓜去皮切片/条，偏老则去籽瓤。",
    "热锅下五花肉，中小火煸至吐油、边缘微焦，加入姜蒜（和可选小米辣）炒香。",
    "加入瓠瓜中大火快炒1-2分钟，必要时盖盖焖2分钟。",
    "开盖大火翻炒收水汽，加盐（和可选生抽）调味。",
    "出锅前撒少许孜然粉（可选）翻匀即可。"
  ],
  "ServingNote": "五花肉先煸出油再炒更香；瓠瓜出水会稀释咸度，建议出锅前再补盐。",
