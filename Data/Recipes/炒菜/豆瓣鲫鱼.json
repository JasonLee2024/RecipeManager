{
  "ID": "46738ed2-b816-4f28-b26c-611748001ff4",
  "Name": "豆瓣鲫鱼",
  "Category": "炒菜",
  "PrepTime": 45,
  "Ingredients": [
    {
      "Item": "鲫鱼",
      "Amount": "1条（约500-700克）"
    },
    {
      "Item": "郫县豆瓣酱",
      "Amount": "1-2大勺（剁细）"
    },
    {
      "Item": "姜末、蒜末、葱花",
      "Amount": "适量"
    },
    {
      "Item": "料酒、酱油",
      "Amount": "适量"
    },
    {
      "Item": "白糖",
      "Amount": "较平时略多"
    },
    {
      "Item": "米醋",
      "Amount": "分两次加入"
    },
    {
      "Item": "水淀粉",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "鲫鱼处理干净并擦干，入锅煎至两面金黄后盛出备用。",
    "锅中留底油，低油温慢煸剁细豆瓣酱至红油透亮，加入姜末蒜末炒香。",
    "烹入料酒并加水，放酱油、白糖和大部分米醋调味，煮开后转中小火。",
    "放入煎好的鱼烧至成熟入味，期间反复将汤汁浇在鱼身上。",
    "鱼先装盘，锅中汤汁勾薄芡，下葱花和少许生醋推匀后淋在鱼身。"
  ],
  "ServingNote": "鱼先煎至干身可避免烧制时散碎；若改做豆瓣鲤鱼，可按同法替换鱼种并适当延长烧制时间。",
