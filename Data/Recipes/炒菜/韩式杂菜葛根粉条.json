{
  "ID": "c20c3f3f-66c0-484e-85bd-644df6198ff6",
  "Name": "韩式杂菜葛根粉条",
  "Category": "炒菜",
  "PrepTime": 35,
  "Ingredients": [
    {
      "Item": "葛根粉条",
      "Amount": "干约80～100g"
    },
    {
      "Item": "牛肉",
      "Amount": "100～120g，切丝"
    },
    {
      "Item": "洋葱",
      "Amount": "1/4个"
    },
    {
      "Item": "红椒",
      "Amount": "彩椒适量"
    },
    {
      "Item": "香菇",
      "Amount": "数朵切丝，或金针菇一小把"
    },
    {
      "Item": "菠菜",
      "Amount": "数棵（可选）"
    },
    {
      "Item": "大蒜",
      "Amount": "1～2瓣"
    },
    {
      "Item": "生抽",
      "Amount": "1.5～2汤匙"
    },
    {
      "Item": "香油",
      "Amount": "1～1.5汤匙"
    },
    {
      "Item": "白糖",
      "Amount": "1/2～1茶匙"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "粉条泡软煮熟沥干，淋少许香油拌匀；牛肉丝用生抽、糖、淀粉腌10分钟。",
    "分别快炒或焯熟配菜；牛肉丝大火炒至变色盛出。",
    "炒香蒜末，下洋葱、彩椒、菌菇炒软，下粉条加生抽、糖与可选韩式辣酱翻匀，回锅牛肉与蔬菜，淋香油撒芝麻出锅。"
  ],
