{
  "ID": "c9ef002d-dad3-4e12-82bd-1b482ed2a366",
  "Name": "杂锦炒葛根粉条",
  "Category": "炒菜",
  "PrepTime": 30,
  "Ingredients": [
    {
      "Item": "葛根粉条",
      "Amount": "干约80～100g"
    },
    {
      "Item": "牛肉",
      "Amount": "150～200g"
    },
    {
      "Item": "洋葱",
      "Amount": "半个"
    },
    {
      "Item": "红椒",
      "Amount": "彩椒半个"
    },
    {
      "Item": "大蒜",
      "Amount": "2瓣"
    },
    {
      "Item": "生抽",
      "Amount": "1.5汤匙"
    },
    {
      "Item": "蚝油",
      "Amount": "1汤匙（可选）"
    },
    {
      "Item": "料酒",
      "Amount": "1茶匙"
    },
    {
      "Item": "白糖",
      "Amount": "少许"
    },
    {
      "Item": "食盐",
      "Amount": "少许"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "粉条泡软煮熟沥干，少油拌匀防粘；牛肉切条或片，用生抽、料酒、淀粉腌10分钟。",
    "热锅大火滑炒牛肉至变色盛出。",
    "爆香蒜片，下洋葱、彩椒炒至断生，倒入粉条与牛肉，加生抽、蚝油、料酒、糖大火翻匀，补盐出锅。"
  ],
