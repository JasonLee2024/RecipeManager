{
  "ID": "cedd0575-0dbf-4683-81a3-19d058c0132d",
  "Name": "香煎鲈鱼",
  "Category": "炒菜",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "鲈鱼",
      "Amount": "两片鱼柳或半片带皮鱼身，约250～400g净肉"
    },
    {
      "Item": "食盐",
      "Amount": "少许腌制"
    },
    {
      "Item": "黑胡椒",
      "Amount": "适量"
    },
    {
      "Item": "植物油",
      "Amount": "平底锅薄油一层"
    },
    {
      "Item": "柠檬",
      "Amount": "1/4～1/2个挤汁"
    },
    {
      "Item": "芦笋",
      "Amount": "配菜可选"
    },
    {
      "Item": "小番茄",
      "Amount": "配菜可选"
    }
  ],
  "Steps": [
    "鱼肉用厨房纸彻底吸干，两面抹盐与黑胡椒，腌10分钟。",
    "平底锅预热倒油，鱼皮朝下中火入锅，轻压贴锅煎3～4分钟至金黄酥脆。",
    "翻面再煎2～3分钟至鱼肉不透明、中心仍多汁。",
    "盛出搭配配菜，挤柠檬汁佐餐。"
  ],
  "ServingNote": "脆皮要点：干爽、中等油温、皮面先定型勿早翻动。整鱼可先蝴蝶切开摊平。海鲈鱼减盐。",
