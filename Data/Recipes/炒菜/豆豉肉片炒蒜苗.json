{
  "ID": "fd1f16af-c85f-4fc3-bd9f-909973446b30",
  "Name": "豆豉肉片炒蒜苗",
  "Category": "炒菜",
  "PrepTime": 20,
  "Ingredients": [
    {
      "Item": "猪肉片",
      "Amount": "250至300g"
    },
    {
      "Item": "蒜苗",
      "Amount": "250g"
    },
    {
      "Item": "豆豉",
      "Amount": "1大勺"
    },
    {
      "Item": "郫县豆瓣酱",
      "Amount": "1小勺（可选）"
    },
    {
      "Item": "大蒜",
      "Amount": "2瓣"
    },
    {
      "Item": "生姜",
      "Amount": "1小块"
    },
    {
      "Item": "料酒",
      "Amount": "1小勺"
    },
    {
      "Item": "生抽",
      "Amount": "少许（按需）"
    },
    {
      "Item": "白糖",
      "Amount": "少许"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "肉片用少量料酒抓匀静置10分钟，蒜苗分开蒜白与蒜绿，豆豉碾散备用。",
    "锅中下油烧至六成热，下肉片中火煸炒至变色并略出油。",
    "把肉拨到锅边，小火炒香蒜末、姜末、豆豉及可选豆瓣酱。",
    "合并翻炒后先下蒜白、再下蒜绿，大火快炒至断生。",
    "按咸度补少许生抽，最后加少量白糖提鲜后出锅。"
  ],
