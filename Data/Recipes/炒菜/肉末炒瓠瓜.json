{
  "ID": "4a3b1d7e-55c7-4f22-b9ea-9a2f8b2d1c44",
  "Name": "肉末炒瓠瓜",
  "Category": "炒菜",
  "PrepTime": 20,
  "Ingredients": [
    {
      "Item": "瓠瓜",
      "Amount": "约400克（去皮切片/条）"
    },
    {
      "Item": "猪肉末",
      "Amount": "150-200克"
    },
    {
      "Item": "葱姜蒜",
      "Amount": "少许"
    },
    {
      "Item": "干辣椒",
      "Amount": "1-2个（可选）"
    },
    {
      "Item": "生抽",
      "Amount": "1-2勺"
    },
    {
      "Item": "老抽",
      "Amount": "少许（可选，上色）"
    },
    {
      "Item": "盐、食用油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "瓠瓜去皮切片/条，偏老则去籽瓤；葱姜蒜切好。",
    "热锅下油，下肉末炒散变色，加入葱姜蒜（和可选干辣椒）炒香。",
    "加入瓠瓜翻炒1分钟，加入生抽（和可选老抽）调味上色。",
    "盖盖中小火焖2-4分钟后开盖大火收汁，尝味后再补盐出锅。"
  ],
  "ServingNote": "瓠瓜出水多，用“适度焖”更容易入味；先尝味再补盐更稳。",
