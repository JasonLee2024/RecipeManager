{
  "ID": "084a9ed8-5f34-4203-9abd-70f76b4aae38",
  "Name": "葛根粉条煲",
  "Category": "炒菜",
  "PrepTime": 55,
  "Ingredients": [
    {
      "Item": "葛根粉条",
      "Amount": "干约80～100g"
    },
    {
      "Item": "鸡肉",
      "Amount": "300～400g（鸡腿或鸡块）"
    },
    {
      "Item": "豆腐",
      "Amount": "老豆腐200g切块"
    },
    {
      "Item": "鱼丸",
      "Amount": "适量（可选）"
    },
    {
      "Item": "香菇",
      "Amount": "3～4朵切块（可选）"
    },
    {
      "Item": "生姜",
      "Amount": "数片"
    },
    {
      "Item": "大蒜",
      "Amount": "3瓣"
    },
    {
      "Item": "生抽",
      "Amount": "2汤匙"
    },
    {
      "Item": "蚝油",
      "Amount": "1汤匙（可选）"
    },
    {
      "Item": "料酒",
      "Amount": "1汤匙"
    },
    {
      "Item": "白糖",
      "Amount": "适量"
    },
    {
      "Item": "食盐",
      "Amount": "适量"
    },
    {
      "Item": "清水",
      "Amount": "没过食材"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "粉条温水泡软；鸡块可焯水去沫洗净。",
    "砂锅热油煸香姜蒜，下鸡块炒至微黄，淋料酒，加清水或高汤烧开。",
    "下豆腐、香菇中小火炖15～20分钟，再下鱼丸（若用）与粉条，加生抽、蚝油、糖炖8～12分钟，补盐收汁。"
  ],
