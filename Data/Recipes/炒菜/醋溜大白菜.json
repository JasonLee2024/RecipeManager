{
  "ID": "5b5c7629-3a06-4d21-bfdb-53e64be4bb91",
  "Name": "醋溜大白菜",
  "Category": "炒菜",
  "PrepTime": 15,
  "Ingredients": [
    {
      "Item": "大白菜",
      "Amount": "约500g（半个）"
    },
    {
      "Item": "大蒜",
      "Amount": "4至5瓣"
    },
    {
      "Item": "生姜",
      "Amount": "1小块"
    },
    {
      "Item": "干辣椒",
      "Amount": "3至4个（可选）"
    },
    {
      "Item": "花椒",
      "Amount": "1小撮"
    },
    {
      "Item": "大葱或香葱",
      "Amount": "少许"
    },
    {
      "Item": "生抽",
      "Amount": "2勺"
    },
    {
      "Item": "陈醋或香醋",
      "Amount": "2勺"
    },
    {
      "Item": "白糖",
      "Amount": "1勺"
    },
    {
      "Item": "盐",
      "Amount": "半勺"
    },
    {
      "Item": "玉米淀粉",
      "Amount": "1勺"
    },
    {
      "Item": "清水",
      "Amount": "小半碗"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "白菜洗净后菜帮菜叶分开处理：菜帮斜切片，菜叶手撕大片，并尽量控干表面水分。",
    "将生抽、醋、糖、盐、淀粉和清水提前调成碗汁，搅匀备用。",
    "热锅下油，花椒小火炸香后捞出，再下蒜末、姜末和干辣椒炒香。",
    "转大火先下白菜帮快炒约30秒，再下白菜叶快炒约20秒至刚变软。",
    "沿锅边倒入碗汁，大火翻炒10至15秒，待芡汁裹匀后立即出锅。"
  ],
