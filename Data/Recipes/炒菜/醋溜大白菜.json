{
  "ID": "5b5c7629-3a06-4d21-bfdb-53e64be4bb91",
  "Name": "醋溜大白菜",
  "Category": "炒菜",
  "PrepTime": 20,
  "Ingredients": [
    {
      "Item": "大白菜",
      "Amount": "约500g（半个，宜选近菜心部位）"
    },
    {
      "Item": "食醋（陈醋或香醋等）",
      "Amount": "2至3汤匙"
    },
    {
      "Item": "干辣椒",
      "Amount": "2至4个（剪段，可选新鲜小红椒）"
    },
    {
      "Item": "香油",
      "Amount": "1茶匙"
    },
    {
      "Item": "大蒜",
      "Amount": "3至4瓣（切片或拍碎）"
    },
    {
      "Item": "生姜",
      "Amount": "2至3片"
    },
    {
      "Item": "白糖",
      "Amount": "约半茶匙"
    },
    {
      "Item": "盐",
      "Amount": "适量（约半茶匙或起锅前补）"
    },
    {
      "Item": "清水",
      "Amount": "约1汤匙（15ml，入碗汁）"
    },
    {
      "Item": "植物油",
      "Amount": "适量（略多于日常炒菜）"
    }
  ],
  "Steps": [
    "白菜洗净沥干，菜帮斜切成片，菜叶撕或切成大块，分开放置。",
    "小碗中将醋、糖、盐（若用）与清水调成碗汁，搅匀备用。",
    "锅中倒油中火烧热，下干辣椒段、姜片、蒜片煸香，注意勿炒糊。",
    "倒入菜帮转大火快炒约1至2分钟至边缘略透明微软。",
    "下白菜叶大火快炒约30秒至叶片变软。",
    "沿锅边淋入碗汁大火翻匀，关火后淋香油借余热拌匀即可出锅。"
  ],
  "ServingNote": "趁热食用风味最佳；冷藏后口感变差，建议现做现吃。",
