{
  "ID": "cfa11ff6-8472-4943-a5ff-808019b0471c",
  "Name": "柠香鲈鱼",
  "Category": "炒菜",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "鲈鱼",
      "Amount": "1条（约450～650g），处理干净"
    },
    {
      "Item": "生姜",
      "Amount": "适量（蒸鱼用）"
    },
    {
      "Item": "大葱",
      "Amount": "适量（蒸鱼用）"
    },
    {
      "Item": "鱼露",
      "Amount": "1.5～2汤匙"
    },
    {
      "Item": "青柠",
      "Amount": "2～3个取汁，另切片装饰"
    },
    {
      "Item": "大蒜",
      "Amount": "2～3瓣切末"
    },
    {
      "Item": "小米辣",
      "Amount": "1～2根切圈"
    },
    {
      "Item": "白糖",
      "Amount": "1～1.5茶匙"
    },
    {
      "Item": "香菜",
      "Amount": "少许（可选）"
    },
    {
      "Item": "植物油",
      "Amount": "少许（可选浇油）"
    }
  ],
  "Steps": [
    "鲈鱼按清蒸法蒸熟：水开后大火蒸8～10分钟，关火虚蒸约2分钟。",
    "鱼露、青柠汁、蒜末、小米辣、白糖加少许温开水调成酸辣汁，尝味调整。",
    "倒掉蒸鱼汤汁，淋上酸辣汁，铺青柠片与香菜；喜香者可轻淋热油。"
  ],
  "ServingNote": "鱼露咸度高，慎补盐；蒸前吸干鱼身。海鲈鱼宜减少鱼露。文档注明酸辣风味接近东南亚家常蒸鱼，地域标签未单列泰国菜（配置外）。",
