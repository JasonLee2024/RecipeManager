{
  "ID": "d1f10ab2-8737-4c55-a9cc-205feb2358fc",
  "Name": "豆豉蒜苗炒豆腐",
  "Category": "炒菜",
  "PrepTime": 20,
  "Ingredients": [
    {
      "Item": "老豆腐",
      "Amount": "300g"
    },
    {
      "Item": "蒜苗",
      "Amount": "200至250g"
    },
    {
      "Item": "豆豉",
      "Amount": "1大勺"
    },
    {
      "Item": "大蒜",
      "Amount": "2瓣"
    },
    {
      "Item": "生抽",
      "Amount": "1小勺"
    },
    {
      "Item": "白糖",
      "Amount": "少许"
    },
    {
      "Item": "盐",
      "Amount": "少许（按需）"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "老豆腐切块后下锅煎至两面金黄盛出，蒜苗分开蒜白与蒜绿。",
    "锅中留底油，小火炒香蒜末和豆豉。",
    "转大火先下蒜白快炒约20秒，再下蒜绿继续快炒。",
    "倒回豆腐块，淋入生抽翻匀，补少许白糖提鲜。",
    "尝味后按需补盐，炒至蒜苗断生即可出锅。"
  ],
