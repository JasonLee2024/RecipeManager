{
  "ID": "a3c91e2b-4f08-4d6a-9c11-8e4b2d7f6011",
  "Name": "木耳炒鸡蛋",
  "Category": "炒菜",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "干木耳（秋木耳）",
      "Amount": "10-15克"
    },
    {
      "Item": "鸡蛋",
      "Amount": "2-3个"
    },
    {
      "Item": "食用油",
      "Amount": "适量"
    },
    {
      "Item": "盐",
      "Amount": "适量"
    },
    {
      "Item": "白糖",
      "Amount": "少许"
    },
    {
      "Item": "白胡椒粉",
      "Amount": "少许"
    },
    {
      "Item": "葱花或蒜末",
      "Amount": "少许"
    },
    {
      "Item": "清水或白醋（入蛋液）",
      "Amount": "约1茶匙"
    },
    {
      "Item": "胡萝卜片（可选配菜）",
      "Amount": "按需"
    },
    {
      "Item": "黄瓜片（可选配菜）",
      "Amount": "按需"
    },
    {
      "Item": "青椒（可选配菜）",
      "Amount": "按需"
    }
  ],
  "Steps": [
    "干木耳冷水泡发约2小时至完全变软，搓洗去沙，沥干；可选沸水焯烫1-2分钟后沥干。撕成小朵。",
    "鸡蛋加少许盐，入约一茶匙清水或几滴白醋搅匀。",
    "热锅凉油，油温约五成热倒入蛋液，划散炒至七分熟盛出。",
    "锅中补少许油，爆香葱或蒜；下木耳。胡萝卜片、青椒可与木耳同时下锅，中大火翻炒1-2分钟至断生。黄瓜片易出水，不宜与木耳久炒同煸，可留到下一步与鸡蛋同下或出锅前再快速翻匀。用盐、糖、白胡椒粉调味。",
    "倒回鸡蛋（若用黄瓜片，可在此步与蛋一起下锅翻匀），大火翻炒均匀；可沿锅边淋入少许热水促融合，出锅前可点香醋或香油。"
  ],
