{
  "ID": "9e6c1a03-d5b4-6f83-1c25-4b0a8f3e6d22",
  "Name": "清炒木耳菜",
  "Category": "炒菜",
  "PrepTime": 10,
  "Ingredients": [
    {
      "Item": "木耳菜",
      "Amount": "适量（掐老梗洗净沥干）"
    },
    {
      "Item": "大蒜",
      "Amount": "切末，分两次下锅"
    },
    {
      "Item": "食盐",
      "Amount": "适量"
    },
    {
      "Item": "鸡精",
      "Amount": "少许（可选）"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    },
    {
      "Item": "白酒",
      "Amount": "约一瓶盖（酒香版）"
    }
  ],
  "Steps": [
    "大火热油下一半蒜末爆香，立即下木耳菜快速翻炒至叶软。",
    "加盐与可选鸡精，下另一半蒜末炒匀出锅。",
    "酒香版：菜变软时沿锅边烹白酒，中大火再炒约2分钟至软。"
  ],
