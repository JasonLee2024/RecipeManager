{
  "ID": "3f6319db-f07f-4726-9f66-eb0e39a50129",
  "Name": "回锅肉",
  "Category": "炒菜",
  "PrepTime": 45,
  "Ingredients": [
    {
      "Item": "二刀肉或带皮五花肉",
      "Amount": "300-400克"
    },
    {
      "Item": "蒜苗",
      "Amount": "3-4根（蒜白蒜叶分开）"
    },
    {
      "Item": "郫县豆瓣酱",
      "Amount": "1大勺（剁细）"
    },
    {
      "Item": "甜面酱",
      "Amount": "少许（可选）"
    },
    {
      "Item": "酱油、白糖",
      "Amount": "少许"
    },
    {
      "Item": "米醋",
      "Amount": "锅边点入少许"
    }
  ],
  "Steps": [
    "猪肉冷水下锅煮至断生，捞出放凉后切薄片。",
    "锅中少油下肉片中火煸炒，至吐油、卷曲并出现灯盏窝状态。",
    "将肉推到锅边，用底油低油温慢煸剁细豆瓣酱和少许甜面酱至红油透亮。",
    "回锅肉片翻炒均匀，加少许酱油和白糖调味。",
    "先下蒜白再下蒜叶，大火快炒十几秒，锅边淋几滴醋后立即出锅。"
  ],
  "ServingNote": "此菜重在锅气与节奏，蒜苗断生即出锅口感最佳；豆瓣酱本身带盐，通常无需再加盐。",
