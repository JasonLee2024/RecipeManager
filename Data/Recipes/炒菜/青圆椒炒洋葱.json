{
  "ID": "d7f2a9c1-8e4b-42d6-b3a0-5c6d7e8f9012",
  "Name": "青圆椒炒洋葱",
  "Category": "炒菜",
  "PrepTime": 15,
  "Ingredients": [
    {
      "Item": "青圆椒",
      "Amount": "适量，去蒂去籽，滚刀块或细丝"
    },
    {
      "Item": "洋葱",
      "Amount": "适量，切块与青椒大小相近"
    },
    {
      "Item": "食盐",
      "Amount": "适量"
    },
    {
      "Item": "白糖",
      "Amount": "少许"
    },
    {
      "Item": "生抽",
      "Amount": "少许"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    },
    {
      "Item": "鸡蛋",
      "Amount": "2个（可选）"
    },
    {
      "Item": "五花肉片",
      "Amount": "少许（可选，煸猪油）"
    }
  ],
  "Steps": [
    "热锅冷油，下洋葱大火煸炒至出香味、边缘微透明。",
    "下青椒快速翻炒20～30秒，保持清脆翠绿。",
    "盐、少许糖、生抽调味，炒匀出锅。",
    "若加蛋：先炒散盛起，再炒蔬菜后合炒。"
  ],
