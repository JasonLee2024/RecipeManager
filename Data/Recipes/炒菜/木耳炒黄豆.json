{
  "ID": "b7d82f3c-5e19-5e7b-ad22-9f5c3e8a7122",
  "Name": "木耳炒黄豆",
  "Category": "炒菜",
  "PrepTime": 40,
  "Ingredients": [
    {
      "Item": "黄豆（干）",
      "Amount": "适量（提前浸泡4小时以上）"
    },
    {
      "Item": "干木耳",
      "Amount": "适量"
    },
    {
      "Item": "鸡蛋",
      "Amount": "2-3个"
    },
    {
      "Item": "葱、姜、蒜",
      "Amount": "适量"
    },
    {
      "Item": "小米辣",
      "Amount": "可选"
    },
    {
      "Item": "生抽",
      "Amount": "1-2勺"
    },
    {
      "Item": "蚝油",
      "Amount": "1勺"
    },
    {
      "Item": "盐",
      "Amount": "少许"
    },
    {
      "Item": "白糖",
      "Amount": "少许（提鲜）"
    },
    {
      "Item": "食用油",
      "Amount": "适量"
    },
    {
      "Item": "黄豆酱（酱香变体）",
      "Amount": "可选，约1小勺（可替代部分盐，增酱香）"
    }
  ],
  "Steps": [
    "黄豆浸泡至胀发后冷水下锅，水开后中小火煮15-20分钟至粉软，捞出沥干。",
    "干木耳冷水泡发2-3小时，洗净撕小朵，沸水焯烫1-2分钟沥干。",
    "鸡蛋加少许盐与白醋打散，滑炒至定型盛出。",
    "锅中放油，小火爆香葱、姜、蒜（喜辣可加小米辣），下木耳与煮熟黄豆大火翻炒约30秒。",
    "淋入生抽、蚝油炒匀，倒入鸡蛋；补味时盐与黄豆酱二选一为主：只用盐则不放黄豆酱；用黄豆酱（约1小勺）则少放盐或不放盐，依酱的咸度调整。加少许糖提鲜，大火快炒1-2分钟，撒葱花出锅。"
  ],
  "Tags": [
    "炒菜",
    "中式家常菜",
