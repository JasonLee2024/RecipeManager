{
  "ID": "620d932b-7a59-43fe-a9a0-db40a16520f0",
  "Name": "花蛤炒葛根粉条",
  "Category": "炒菜",
  "PrepTime": 35,
  "Ingredients": [
    {
      "Item": "葛根粉条",
      "Amount": "干约80～100g"
    },
    {
      "Item": "花蛤",
      "Amount": "300～400g"
    },
    {
      "Item": "鸡蛋",
      "Amount": "1～2个"
    },
    {
      "Item": "生姜",
      "Amount": "2片"
    },
    {
      "Item": "大蒜",
      "Amount": "2瓣"
    },
    {
      "Item": "生抽",
      "Amount": "1～1.5汤匙"
    },
    {
      "Item": "蚝油",
      "Amount": "1汤匙"
    },
    {
      "Item": "料酒",
      "Amount": "1汤匙"
    },
    {
      "Item": "白糖",
      "Amount": "少许"
    },
    {
      "Item": "食盐",
      "Amount": "少许"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "粉条泡软煮熟沥干备用；花蛤吐沙洗净，沸水加料酒焯至开口捞出，留少许清汤过滤。",
    "鸡蛋炒散盛出；爆香姜蒜，下可选虾仁炒熟。",
    "倒入花蛤与粉条，加生抽、蚝油、糖与少量蛤汤大火翻匀，回鸡蛋撒葱花，尝味补盐出锅。"
  ],
