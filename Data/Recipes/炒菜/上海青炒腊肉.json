{
  "ID": "bbaacf91-4619-4548-8d44-82e8d89c5194",
  "Name": "上海青炒腊肉",
  "Category": "炒菜",
  "PrepTime": 25,
  "Ingredients": [
    { "Item": "上海青", "Amount": "400～500g" },
    { "Item": "腊肉", "Amount": "80～120g，切薄片" },
    { "Item": "大蒜", "Amount": "2～3瓣" },
    { "Item": "生抽", "Amount": "约1茶匙（可选）" },
    { "Item": "食盐", "Amount": "少许或省略" },
    { "Item": "植物油", "Amount": "少量" }
  ],
  "Steps": [
    "腊肉片入锅，中小火煸炒出油、边缘略卷曲透明。",
    "下蒜片与可选干辣椒段煸香。",
    "转大火，先下菜梗翻炒，再下菜叶，沿锅边可淋少许生抽，炒匀出锅；口淡可不再加盐。"
  ],
