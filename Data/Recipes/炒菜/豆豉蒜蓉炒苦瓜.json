  "ID": "ace0ca20-d976-4d13-982b-d52f855a2657",
  "Name": "豆豉蒜蓉炒苦瓜",
  "Category": "炒菜",
  "PrepTime": 20,
  "Ingredients": [
    {
      "Item": "苦瓜",
      "Amount": "1根"
    },
    {
      "Item": "豆豉",
      "Amount": "1小把"
    },
    {
      "Item": "大蒜",
      "Amount": "半头"
    },
    {
      "Item": "小米辣",
      "Amount": "1至2根（可选）"
    },
    {
      "Item": "白糖",
      "Amount": "半小勺"
    },
    {
      "Item": "生抽",
      "Amount": "少许"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "苦瓜剖开刮净白瓤，切薄片；沸水加盐与油，焯烫约30秒，捞出过凉沥干。",
    "小火煸香豆豉碎、蒜末与小米辣。",
    "转大火下苦瓜片快炒约1分钟。",
    "加白糖与少许生抽炒匀，按咸度决定是否补盐，出锅。"
  ],
