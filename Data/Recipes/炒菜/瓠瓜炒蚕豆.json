{
  "ID": "3f1e0f0a-6b57-4c2a-94a9-0e2b0b3a1c9e",
  "Name": "瓠瓜炒蚕豆",
  "Category": "炒菜",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "瓠瓜",
      "Amount": "约300-400克（去皮切块/片）"
    },
    {
      "Item": "蚕豆仁",
      "Amount": "约200-300克"
    },
    {
      "Item": "盐",
      "Amount": "适量"
    },
    {
      "Item": "鸡精、白胡椒",
      "Amount": "少许（可选）"
    },
    {
      "Item": "食用油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "瓠瓜去皮切块/片；蚕豆仁洗净备用。",
    "热锅下油，下瓠瓜翻炒1-2分钟。",
    "加入蚕豆仁同炒1分钟，沿锅边加少量热水，盖盖小火焖5-8分钟至熟软。",
    "开盖大火收水汽，加盐（和可选鸡精/白胡椒）调味出锅。"
  ],
  "ServingNote": "蚕豆熟得慢，适合“先炒后焖”；蚕豆偏老可先焯水1分钟。",
