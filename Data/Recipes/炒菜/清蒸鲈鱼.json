{
  "ID": "9320bba2-b763-4027-96ce-f5376d508c8c",
  "Name": "清蒸鲈鱼",
  "Category": "炒菜",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "鲈鱼",
      "Amount": "1条（约450～650g），去鳞去鳃去内脏洗净"
    },
    {
      "Item": "生姜",
      "Amount": "1小块切片"
    },
    {
      "Item": "大葱",
      "Amount": "适量，切段与切丝"
    },
    {
      "Item": "红椒",
      "Amount": "少许切丝（可选）"
    },
    {
      "Item": "蒸鱼豉油",
      "Amount": "3～4汤匙"
    },
    {
      "Item": "植物油",
      "Amount": "1～2汤匙浇油用"
    },
    {
      "Item": "料酒",
      "Amount": "1汤匙（可选）"
    }
  ],
  "Steps": [
    "鱼身两面斜划几刀至鱼骨，腹内塞姜片与葱段；盘底可垫筷架空鱼身（可选）。",
    "蒸锅水烧开后放入鱼盘，大火蒸8～10分钟（视大小），关火虚蒸约2分钟。",
    "取出倒掉盘中汤汁，拣去旧葱姜，铺新鲜葱丝与红椒丝，淋蒸鱼豉油。",
    "植物油烧至微微冒烟，浇在葱丝上激香即成。"
  ],
  "ServingNote": "鱼身内外吸干水分再蒸；务必倒掉蒸汁减腥。海鲈鱼含盐较高可减少豉油。蒸久易柴，以鱼眼略凸、肉离刺为度。",
