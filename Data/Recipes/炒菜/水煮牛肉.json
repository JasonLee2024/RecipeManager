{
  "ID": "991ef787-9fd3-4860-92fe-eb2bf2c2de41",
  "Name": "水煮牛肉",
  "Category": "炒菜",
  "PrepTime": 40,
  "Ingredients": [
    {
      "Item": "牛肉片",
      "Amount": "300克"
    },
    {
      "Item": "豆芽或生菜",
      "Amount": "适量"
    },
    {
      "Item": "郫县豆瓣酱",
      "Amount": "2大勺（剁细）"
    },
    {
      "Item": "姜末、蒜末",
      "Amount": "适量"
    },
    {
      "Item": "刀口辣椒、花椒",
      "Amount": "大量（封油用）"
    },
    {
      "Item": "料酒、酱油、白糖、白胡椒粉",
      "Amount": "适量"
    },
    {
      "Item": "菜籽油",
      "Amount": "适量（底油+响油）"
    }
  ],
  "Steps": [
    "牛肉片简单腌制后在微开水中滑煮至八九成熟，捞出铺在焯熟垫菜上。",
    "锅中下油，低油温慢煸剁细豆瓣酱至红油亮丽，加入姜末蒜末炒香。",
    "加高汤或清水，用料酒、少许酱油、白糖和白胡椒粉调味，小火熬煮几分钟后浇在牛肉上。",
    "碗中央放蒜末、刀口辣椒和花椒。",
    "另起锅将菜籽油烧至七八成热，猛浇在香料上爆香即可。"
  ],
  "ServingNote": "此菜有“底油”和“响油”两段用油：底油负责煸红煸香，响油负责瞬时激发香气；也可等量替换主料做水煮鱼。",
