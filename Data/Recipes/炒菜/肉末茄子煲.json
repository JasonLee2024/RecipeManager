{
  "ID": "2904ccc4-8455-4655-bc77-de3941ec1d90",
  "Name": "肉末茄子煲",
  "Category": "炒菜",
  "PrepTime": 30,
  "Ingredients": [
    {
      "Item": "茄子",
      "Amount": "约500g"
    },
    {
      "Item": "猪肉末",
      "Amount": "150至200g"
    },
    {
      "Item": "生姜",
      "Amount": "1小块"
    },
    {
      "Item": "大蒜",
      "Amount": "2至3瓣"
    },
    {
      "Item": "豆瓣酱或黄豆酱",
      "Amount": "1至1.5勺"
    },
    {
      "Item": "料酒",
      "Amount": "1勺"
    },
    {
      "Item": "生抽",
      "Amount": "1勺"
    },
    {
      "Item": "老抽",
      "Amount": "半勺"
    },
    {
      "Item": "白糖",
      "Amount": "少许"
    },
    {
      "Item": "青蒜苗或小葱",
      "Amount": "适量"
    },
    {
      "Item": "盐",
      "Amount": "约1小勺（腌茄用）"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "茄子切长条后盐腌10分钟并挤干，按习惯选择快炒或先过油处理。",
    "锅中下油炒散肉末至发白，淋料酒并下姜蒜末和豆瓣酱小火炒香。",
    "加入茄子条大火翻匀，放生抽、老抽、白糖调味。",
    "加入清水至茄子高度约一半，中火焖约3分钟让茄子吸汁。",
    "大火收汁，撒青蒜苗或葱花后出锅。"
  ],
