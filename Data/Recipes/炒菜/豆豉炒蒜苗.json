{
  "ID": "f09db2e5-e994-4a76-9a63-f23f94362def",
  "Name": "豆豉炒蒜苗",
  "Category": "炒菜",
  "PrepTime": 15,
  "Ingredients": [
    {
      "Item": "蒜苗",
      "Amount": "200至300g"
    },
    {
      "Item": "豆豉",
      "Amount": "1至2大勺"
    },
    {
      "Item": "大蒜",
      "Amount": "2至3瓣"
    },
    {
      "Item": "生姜",
      "Amount": "1小块"
    },
    {
      "Item": "干辣椒",
      "Amount": "2至3个（可选）"
    },
    {
      "Item": "生抽",
      "Amount": "1大勺"
    },
    {
      "Item": "白糖",
      "Amount": "少许"
    },
    {
      "Item": "盐",
      "Amount": "少许"
    },
    {
      "Item": "植物油",
      "Amount": "2大勺"
    }
  ],
  "Steps": [
    "干豆豉先冲洗并温水浸泡10分钟后沥干，蒜苗分开蒜白和蒜绿切段。",
    "热锅下油，中小火爆香蒜末、姜末和可选干辣椒，再下豆豉炒出香气。",
    "转大火先下蒜白快炒20至30秒至略透明。",
    "放入蒜绿继续大火快炒15至20秒，淋生抽翻匀。",
    "按咸度补少许盐和白糖，蒜苗断生后立即出锅。"
  ],
