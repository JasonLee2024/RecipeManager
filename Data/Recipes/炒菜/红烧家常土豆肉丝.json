{
  "ID": "ddbf1d42-7075-499a-8e3c-776212fea3f4",
  "Name": "红烧家常土豆肉丝",
  "Category": "炒菜",
  "PrepTime": 30,
  "Ingredients": [
    {
      "Item": "土豆",
      "Amount": "1～2 个（切丝，洗净可略带水分）"
    },
    {
      "Item": "猪瘦肉",
      "Amount": "约 150 g（切丝）"
    },
    {
      "Item": "小葱",
      "Amount": "切葱花"
    },
    {
      "Item": "大蒜",
      "Amount": "切末"
    },
    {
      "Item": "老抽、生抽",
      "Amount": "上色与调味"
    },
    {
      "Item": "料酒、白糖、水淀粉",
      "Amount": "适量"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    },
    {
      "Item": "热水",
      "Amount": "少量（收汁）"
    }
  ],
  "Steps": [
    "肉丝用料酒、老抽、水淀粉抓匀腌制。",
    "土豆丝洗净后可略带少许水分备用。",
    "热锅凉油将肉丝滑熟后盛出。",
    "余油爆香蒜末，倒入土豆丝大火翻炒，加老抽、生抽与约半勺糖炒匀上色。",
    "倒回肉丝炒匀；偏干则加少许热水，中火 1～2 分钟至薯丝入味、汤汁略稠，撒葱花出锅。"
  ],
  "ServingNote": "酱香微甜、汤汁适合拌饭；老抽宜适量避免发黑。地域归属不唯一。详见专题共用技巧。",
