{
  "ID": "80ec2d4a-4b93-49f3-a20b-a2e61f436eb0",
  "Name": "萝卜干炒肉",
  "Category": "炒菜",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "萧山萝卜干",
      "Amount": "半包"
    },
    {
      "Item": "瘦肉或肉末",
      "Amount": "约150-200克"
    },
    {
      "Item": "玉米油、白糖",
      "Amount": "适量"
    },
    {
      "Item": "料酒、盐、生抽、太白粉",
      "Amount": "用于腌肉"
    }
  ],
  "Steps": [
    "萝卜干浸泡后切小粒；瘦肉切丁或片，加入料酒、盐、生抽和太白粉腌制10分钟。",
    "热锅下油，先将肉丁快速滑炒至变色，盛出备用。",
    "锅中留底油，下萝卜干粒煸炒出香味。",
    "倒回肉丁与萝卜干翻炒均匀，按口味补少许糖提鲜后出锅。"
  ],
  "ServingNote": "萝卜干和腌肉都带咸味，通常无需再加盐，建议先尝后调。",
  "Tags": [
    "家常菜",
    "浙菜",
    "下饭菜",
    "中式家常菜",
