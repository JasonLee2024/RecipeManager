  "ID": "da86dc88-5302-4c6d-9ccb-fc422ff747cb",
  "Name": "清炒上海青",
  "Category": "炒菜",
  "PrepTime": 15,
  "Ingredients": [
    { "Item": "上海青", "Amount": "400～500g" },
    { "Item": "大蒜", "Amount": "2～3瓣" },
    { "Item": "食盐", "Amount": "适量" },
    { "Item": "植物油", "Amount": "适量" },
    { "Item": "蚝油", "Amount": "少许（可选）" },
    { "Item": "鸡精", "Amount": "少许（可选）" }
  ],
  "Steps": [
    "大棵上海青将菜梗切段、菜叶另放；小棵可整株或对半剖开，洗净沥干。",
    "锅烧热倒植物油，中火下蒜末煸香。",
    "转大火，先下菜梗快速翻炒约20～40秒，再下菜叶翻匀至叶软仍挺。",
    "加盐及可选蚝油、鸡精，快速翻匀后立即出锅。"
  ],
