{
  "ID": "07380d14-94af-4aa5-8c79-7c525c1ec597",
  "Name": "苦瓜炒鸡蛋",
  "Category": "炒菜",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "苦瓜",
      "Amount": "1根"
    },
    {
      "Item": "鸡蛋",
      "Amount": "3至4个"
    },
    {
      "Item": "大蒜",
      "Amount": "2至3瓣"
    },
    {
      "Item": "盐",
      "Amount": "适量"
    },
    {
      "Item": "白胡椒粉",
      "Amount": "少许"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "苦瓜洗净纵向剖开，刮净白瓤与白膜，切薄斜片；加盐腌10分钟后挤干，清水冲去表面多余盐分并沥干。",
    "鸡蛋加少许盐与几滴水或牛奶打散；热锅热油炒蛋至刚凝固盛出。",
    "补油爆香蒜末，大火下苦瓜片快炒约1分钟至断生。",
    "倒回鸡蛋，加盐与白胡椒粉调味，大火翻炒均匀出锅。"
  ],
