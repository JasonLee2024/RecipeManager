{
  "ID": "3d94a6cd-6e3b-4c10-a89d-b81c6d567fd2",
  "Name": "豆豉盐煎肉",
  "Category": "炒菜",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "去皮后腿肉或五花肉",
      "Amount": "300-400克（切约3毫米薄片）"
    },
    {
      "Item": "青蒜",
      "Amount": "3-4根"
    },
    {
      "Item": "永川豆豉",
      "Amount": "15-20克（碾散）"
    },
    {
      "Item": "郫县豆瓣酱",
      "Amount": "1大勺（剁碎）"
    },
    {
      "Item": "姜蒜末",
      "Amount": "适量"
    },
    {
      "Item": "料酒",
      "Amount": "少许"
    },
    {
      "Item": "酱油",
      "Amount": "少许（可选）"
    },
    {
      "Item": "白糖",
      "Amount": "少许"
    }
  ],
  "Steps": [
    "将去皮猪肉稍微冻硬后切约3毫米薄片；青蒜切段，豆豉碾散，豆瓣酱剁碎备用。",
    "锅中放比平时稍多的油，烧至六成热下肉片，中火快速煸炒至变色吐油。",
    "把肉推到锅边，转小火用底油炒香姜蒜末和郫县豆瓣酱，炒出红油。",
    "下豆豉翻炒出香味，烹少许料酒并加少量酱油，与肉片合炒入味。",
    "放入青蒜段转大火快炒约15秒，尝味后加少许白糖提鲜即可出锅。"
  ],
  "ServingNote": "这道菜以干香咸鲜为主，豆豉和豆瓣酱盐分较高，通常不再额外加盐；建议配米饭食用。",
