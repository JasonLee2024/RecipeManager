  "Name": "蒜泥手撕茄子",
  "Category": "蒸菜",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "长条茄子",
      "Amount": "2根"
    },
    {
      "Item": "大蒜",
      "Amount": "1头"
    },
    {
      "Item": "小葱",
      "Amount": "适量"
    },
    {
      "Item": "香菜",
      "Amount": "适量"
    },
    {
      "Item": "小米辣",
      "Amount": "1至2根（可选）"
    },
    {
      "Item": "生抽",
      "Amount": "2勺"
    },
    {
