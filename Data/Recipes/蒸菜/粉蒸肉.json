{
  "ID": "d5f16e4b-7b3c-509d-cd44-2a1b0f9e8155",
  "Name": "粉蒸肉",
  "Category": "蒸菜",
  "PrepTime": 200,
  "Ingredients": [
    {
      "Item": "五花肉（三层五花）",
      "Amount": "500克"
    },
    {
      "Item": "蒸肉米粉",
      "Amount": "150克"
    },
    {
      "Item": "料酒",
      "Amount": "2勺"
    },
    {
      "Item": "生抽",
      "Amount": "2勺"
    },
    {
      "Item": "老抽",
      "Amount": "1勺（上色）"
    },
    {
      "Item": "蚝油",
      "Amount": "1勺"
    },
    {
      "Item": "腐乳汁",
      "Amount": "1勺（可选）"
    },
    {
      "Item": "白糖",
      "Amount": "1小勺"
    },
    {
      "Item": "姜末",
      "Amount": "适量"
    },
    {
      "Item": "蒜末",
      "Amount": "适量"
    },
    {
      "Item": "五香粉",
      "Amount": "少许"
    },
    {
      "Item": "清水（拌米粉用）",
      "Amount": "约50-80ml，少量多次"
    },
    {
      "Item": "垫底配菜（土豆/红薯/南瓜/芋头）",
      "Amount": "适量（可选）"
    },
    {
      "Item": "盐（垫底配菜用）",
      "Amount": "少许"
    },
    {
      "Item": "葱花或香菜",
      "Amount": "出锅点缀"
    }
  ],
  "Steps": [
    "五花肉切约0.5厘米厚片，清水浸泡15分钟去血水，捞出沥干。",
    "肉片入大碗，加料酒、生抽、老抽、蚝油、白糖、姜蒜末、五香粉；腐乳汁为可选增香，不用可省略。抓匀腌制30分钟至1小时。",
    "倒入蒸肉米粉，分次加入清水（约50-80ml），边加边拌至米粉均匀裹肉、湿润不滴水。",
    "垫底配菜去皮切块铺于蒸碗底，撒少许盐；将裹粉肉片码在配菜上（肉皮朝下或平铺均可）。",
    "蒸锅水开后放入蒸碗：大火10分钟后转中小火，继续蒸1.5-2小时至软糯（时间越长越入味；高压锅上汽后约40分钟）。",
    "出锅撒葱花或香菜即可。米粉水宁少勿多：偏干则蒸后偏硬，偏湿则不易成形。",
    "（可选）自制蒸肉米粉：大米与糯米约3:1，加八角、花椒炒香，再用料理机打成粗颗粒。"
  ],
  "ServingNote": "佐餐建议：搭配一碗白米饭，香气更足。",
