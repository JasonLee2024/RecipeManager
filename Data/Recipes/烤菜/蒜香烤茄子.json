{
  "ID": "552d0f7e-5961-4e7b-ad13-dc11c76750fd",
  "Name": "蒜香烤茄子",
  "Category": "烤菜",
  "PrepTime": 30,
  "Ingredients": [
    {
      "Item": "长茄",
      "Amount": "1至2根"
    },
    {
      "Item": "大蒜",
      "Amount": "1头"
    },
    {
      "Item": "小米辣",
      "Amount": "1至2根（可选）"
    },
    {
      "Item": "生抽",
      "Amount": "2勺"
    },
    {
      "Item": "蚝油",
      "Amount": "1勺"
    },
    {
      "Item": "白糖",
      "Amount": "半勺"
    },
    {
      "Item": "孜然粉",
      "Amount": "少许"
    },
    {
      "Item": "盐",
      "Amount": "少许"
    },
    {
      "Item": "葱花",
      "Amount": "适量"
    },
    {
      "Item": "植物油",
      "Amount": "适量"
    }
  ],
  "Steps": [
    "茄子表面刷油，烤箱200°C烤约20分钟或空气炸锅180°C烤约15分钟至发皱变软。",
    "蒜末与小米辣装碗，浇热油激香后加入生抽、蚝油、白糖、孜然粉和盐调成蒜蓉酱。",
    "将烤软茄子划开摊平，铺满蒜蓉酱。",
    "回烤箱或空气炸锅180°C再烤约5分钟。",
    "出炉后撒葱花即可。"
  ],
