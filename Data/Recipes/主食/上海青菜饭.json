{
  "ID": "fb5dfd35-67be-412b-876d-1191580d081a",
  "Name": "上海青菜饭",
  "Category": "主食",
  "PrepTime": 45,
  "Ingredients": [
    { "Item": "大米", "Amount": "2～3人份" },
    { "Item": "香肠", "Amount": "80～120g（或咸肉丁）" },
    { "Item": "上海青", "Amount": "300～400g，切碎" },
    { "Item": "猪油", "Amount": "1～2汤匙（可用植物油代替）" },
    { "Item": "食盐", "Amount": "按咸度少量或不加" },
    { "Item": "生抽", "Amount": "半茶匙（可选）" }
  ],
  "Steps": [
    "大米与香肠或咸肉一起下锅，按常规程序煮至接近熟透。",
    "另起锅熔化猪油，大火炒软上海青碎，可淋少许生抽，盐慎放。",
    "将炒好的上海青拌入饭中翻匀，再焖3～5分钟，起锅前用饭勺翻松。"
  ],
