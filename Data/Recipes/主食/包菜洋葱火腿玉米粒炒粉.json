{
  "ID": "9d18422f-5bd7-4cf2-bcb2-2536fd931e1a",
  "Name": "包菜洋葱火腿玉米粒炒粉",
  "Category": "主食",
  "PrepTime": 25,
  "Ingredients": [
    {
      "Item": "米粉/粉丝",
      "Amount": "200g"
    },
    {
      "Item": "包菜",
      "Amount": "1/4个"
    },
    {
      "Item": "洋葱",
      "Amount": "半个"
    },
    {
      "Item": "火腿片",
      "Amount": "2-3片"
    },
    {
      "Item": "玉米粒肠",
      "Amount": "1-2根"
    },
    {
      "Item": "蒜",
      "Amount": "2瓣"
    },
    {
      "Item": "鸡蛋",
      "Amount": "1个（可选）"
    },
    {
      "Item": "生抽",
      "Amount": "2勺"
    },
    {
      "Item": "老抽",
      "Amount": "半勺"
    },
    {
      "Item": "蚝油",
      "Amount": "1勺"
    },
    {
      "Item": "盐",
      "Amount": "少许"
    },
    {
      "Item": "白胡椒粉",
      "Amount": "少许"
    }
  ],
  "Steps": [
    "米粉提前泡软或按包装煮熟，捞出沥干并拌少许油防粘。",
    "热锅凉油先炒鸡蛋（可选）后盛出；再爆香蒜末。",
    "放入火腿条和玉米粒肠片，小火煸至微焦出香味。",
    "加入洋葱丝中火炒软，再下包菜丝大火快炒至断生。",
    "倒入米粉，转大火，加入生抽、老抽和蚝油快速翻炒均匀。",
    "回锅鸡蛋，按口味补盐和白胡椒粉，继续翻炒2-3分钟至干爽略焦香后出锅。"
  ],
