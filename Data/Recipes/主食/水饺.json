{
  "ID": "75e7654b-d155-4790-973b-88f417d2335b",
  "Name": "水饺",
  "Category": "主食",
  "PrepTime": 60,
  "Ingredients": [
    {
      "Item": "中筋面粉",
      "Amount": "500g"
    },
    {
      "Item": "清水",
      "Amount": "250至260g（和面）"
    },
    {
      "Item": "盐",
      "Amount": "3g（和面）"
    },
    {
      "Item": "猪肉末",
      "Amount": "500g"
    },
    {
      "Item": "大葱",
      "Amount": "150g"
    },
    {
      "Item": "生姜",
      "Amount": "20g"
    },
    {
      "Item": "生抽",
      "Amount": "3勺"
    },
    {
      "Item": "老抽",
      "Amount": "1勺"
    },
    {
      "Item": "蚝油",
      "Amount": "1勺"
    },
    {
      "Item": "花椒粉",
      "Amount": "2g"
    },
    {
      "Item": "香油",
      "Amount": "2勺"
    },
    {
      "Item": "葱姜水",
      "Amount": "约100g"
    }
  ],
  "Steps": [
    "面粉加盐与清水拌成絮后揉成团，静置30分钟再揉至光滑。",
    "猪肉末先加调料搅匀，再分次打入葱姜水，最后拌入葱末与香油。",
    "将面团搓条下剂并擀皮，做到中间略厚、边缘略薄。",
    "包入馅料并捏紧边缘，确保封口完整不漏馅。",
    "水开下饺子，滚沸后分次点水约三次，饺子全部浮起且鼓胀后捞出。"
  ],
