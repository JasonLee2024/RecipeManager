{
  "ID": "fdbc1da7-e702-4ef0-a0df-fe0cb0c561e9",
  "Name": "胡萝卜花菜炒米粉",
  "Category": "主食",
  "PrepTime": 35,
  "Ingredients": [
    {
      "Item": "干米粉",
      "Amount": "2块（约150g）"
    },
    {
      "Item": "五花肉",
      "Amount": "150g"
    },
    {
      "Item": "花菜",
      "Amount": "200g"
    },
    {
      "Item": "胡萝卜",
      "Amount": "半根"
    },
    {
      "Item": "蒜末",
      "Amount": "适量"
    },
    {
      "Item": "小葱段",
      "Amount": "适量"
    },
    {
      "Item": "生抽",
      "Amount": "1勺"
    },
    {
      "Item": "老抽",
      "Amount": "半勺"
    },
    {
      "Item": "蚝油",
      "Amount": "半勺"
    },
    {
      "Item": "盐",
      "Amount": "少许"
    },
    {
      "Item": "白胡椒粉",
      "Amount": "少许"
    }
  ],
  "Steps": [
    "干米粉用温水浸泡20-30分钟，泡至无硬芯后捞出沥干，拌入半勺老抽和少许油防粘上色。",
    "花菜掰小朵后焯水1-2分钟，捞出并尽量沥干水分备用。",
    "热锅少油下五花肉中火煸炒至卷曲金黄、油脂析出，再下蒜末炒香。",
    "加入胡萝卜丝大火快炒约半分钟，再加入花菜，放入生抽、蚝油、盐和白胡椒粉翻匀。",
    "转中小火加入米粉，用筷子和锅铲快速挑散翻炒1-2分钟至干香入味。",
    "最后加入葱段翻炒两下即可出锅。"
  ],
