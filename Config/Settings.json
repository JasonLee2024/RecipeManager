{
  "Policy": {
    "RequiredFields": [
      "ID",
      "Name",
      "Category",
      "Ingredients",
      "Steps"
    ],
    "StrictValidation": true
  },
  "CodingStandard": {
    "Encoding": "UTF-8 with BOM",
    "LineEnding": "CRLF"
  },
  "Storage": {
    "RecipeRoot": "Data/Recipes",
    "RecipePath": "Data/Recipes.json",
    "BackupEnabled": true
  },
  "EnumsPath": "Config/Enums.json",
  "NoodlesPath": "Config/Noodles.json",
  "BeveragesPath": "Config/Beverages.json",
  "RegionalCuisinesPath": "Config/RegionalCuisines.json",
  "CookingTechniquesPath": "Config/CookingTechniques.json",
  "CookingWorkflowPath": "Config/CookingWorkflow.json",
  "HerbalMedicineSchemaPath": "Config/HerbalMedicineSchema.json",
  "HerbalMaterialsPath": "Data/HerbalMaterials.json",
  "HerbalMaterialsRoot": "Data/HerbalMaterials",
  "HerbalMaterialsIndexPath": "Data/HerbalMaterials/index.json",
  "DocsIndexPath": "Docs/CategoryDocIndex.json"
}