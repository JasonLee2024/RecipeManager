{
  "Workflows": {
    "GenericWokWorkflow": {
      "Name": "通用炒锅工作流",
      "TemperatureGuidelines": {
        "爆香起始锅温": ">=180C",
        "滑油区间": "90-120C",
        "初炸定型": "160C",
        "复炸酥化": "190C",
        "热菜上桌最低保持温度": ">=60C"
      },
      "ParallelizableSteps": [
        {
          "Phase": "初加工",
          "CanRunWith": "分拣洗涤",
          "Task": "解冻泡发",
          "Constraint": "避免交叉污染，保持生熟分区"
        },
        {
          "Phase": "精加工",
          "CanRunWith": "腌制静置",
          "Task": "蔬菜切配与调味分装",
          "Constraint": "切配后尽量在15分钟内入锅"
        },
        {
          "Phase": "预热处理",
          "CanRunWith": "焯水",
          "Task": "滑油",
          "Constraint": "双灶并行时需固定分工与传递口令"
        }
      ],
      "PlatingTemplate": {
        "盘1_香料与起锅油": [
          "蒜末/姜末/葱段/葱花",
          "干辣椒/花椒（可选）",
          "起锅油（或提前量好）"
        ],
        "盘2_蛋白类": [
          "已码味/上浆/静置的肉/禽/水产",
          "或已滑油/过油预处理的蛋白（按菜式）"
        ],
        "盘3_耐炒蔬菜": ["根茎类", "较厚菌菇", "耐炒配菜"],
        "盘4_易熟高含水蔬菜": ["叶菜类", "茄果类"],
        "盘5_主食载体": ["米粉/面条（已泡发/煮熟/过凉/沥干）"],
        "盘6_调味料": [
          "调味A（入锅早：上色/挂味）",
          "调味B（出锅前：校正/提香）"
        ]
      },
      "Timeline": [
        {
          "Phase": "T-60_to_T-30",
          "Title": "最慢项先行（解冻/泡发/去盐）",
          "Actions": ["冷藏解冻", "泡发换水去杂", "浸泡脱盐/焯水/蒸软"]
        },
        {
          "Phase": "T-30_to_T-15",
          "Title": "肉类/水产（码味/上浆/静置）",
          "Actions": ["逆丝切/去筋膜", "码味", "上浆/打水吃水", "低温静置/冰镇静置"]
        },
        {
          "Phase": "T-15_to_T-5",
          "Title": "高含水蔬菜（去水后再切配）",
          "Actions": ["清洗", "沥/控/吸干", "手撕分层", "必要时干煸预脱水/盐渍挤水"]
        },
        {
          "Phase": "T-5_to_T0",
          "Title": "分装排队（按下锅顺序分盘）",
          "Actions": ["香料单独分盘", "蛋白单独分盘", "耐炒先/易熟后", "调味分段"]
        }
      ],
      "WokOrder": [
        "热锅（建立锅温）",
        "爆香（短时，防糊）",
        "下蛋白定型（先定型再翻）",
        "下耐炒蔬菜走成熟度",
        "下易熟/高含水蔬菜断生",
        "下主食载体（粉/面）",
        "分段调味（A上色挂味，B校正提香）",
        "快速翻匀出锅"
      ],
      "CriticalControlPoints": [
        {
          "Risk": "交叉污染",
          "Controls": [
            "生熟砧板色标分离（红-生肉，绿-蔬菜，蓝-水产）",
            "每处理一种食材后洗手"
          ],
          "CorrectiveActions": ["发现混用立即消毒工具并更换可疑食材"]
        },
        {
          "Risk": "温度失控",
          "Controls": [
            "爆炒前油温达到可稳定爆香区间",
            "滑油保持在90-120C"
          ],
          "CorrectiveActions": ["温度偏低先升温后下料，偏高先离火降温"]
        },
        {
          "Risk": "时间错位",
          "Controls": ["切配完成后尽快烹饪", "腌制超时需冷藏并复核咸度"],
          "CorrectiveActions": ["超时食材调整到炖煮类场景，避免快炒"]
        }
      ],
      "KPI": [
        {
          "Metric": "备菜完成到首道菜出锅时间",
          "HomeTarget": "<=30min",
          "RestaurantTarget": "<=15min",
          "Method": "计时器"
        },
        {
          "Metric": "食材利用率",
          "HomeTarget": ">=85%",
          "RestaurantTarget": ">=92%",
          "Method": "(成品重量/毛料重量)*100%"
        },
        {
          "Metric": "温度达标率（热菜）",
          "HomeTarget": ">=90%",
          "RestaurantTarget": ">=98%",
          "Method": "红外测温抽检"
        }
      ]
    },
    "StirFriedRiceNoodles": {
      "Name": "炒粉/炒面场景",
      "BasedOn": "GenericWokWorkflow",
      "RecommendedOrder": [
        "爆香蒜末",
        "加工肉类先煸香（火腿/腊肠/培根等）",
        "洋葱等耐炒配菜",
        "包菜断生（保持脆嫩）",
        "米粉入锅",
        "生抽/老抽/蚝油快速翻匀",
        "出锅前补盐/白胡椒（按口味）"
      ]
    }
  }
}

